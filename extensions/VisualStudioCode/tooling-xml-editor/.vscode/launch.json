{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run XML Editor Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Run XML Editor Extension (MSBuild sample)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["${workspaceFolder}/samples/msbuild", "--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Run Integration Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/test/integration/workspace",
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/test/integration/suite"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
