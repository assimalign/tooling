<?xml version="1.0" encoding="UTF-8"?>
<!-- No target namespace: included "chameleon" style, so it adopts urn:library. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:attributeGroup name="identity">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="status" type="statusType" default="active"/>
  </xs:attributeGroup>

  <xs:simpleType name="statusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="active">
        <xs:annotation><xs:documentation>Can be borrowed.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="retired"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
