{
  // Serve MSBuild files in addition to the default .xml and .xsd.
  "xmlEditor.fileExtensions": [".xml", ".xsd", ".csproj", ".vbproj", ".fsproj", ".proj", ".props", ".targets"],
  "xmlEditor.schemas": [
    {
      // SDK-style and other projects without a namespace: <Project Sdk="Microsoft.NET.Sdk">.
      "fileMatch": ["*.csproj", "*.vbproj", "*.fsproj", "*.proj", "*.props", "*.targets"],
      "url": "./schemas/Microsoft.Build.xsd"
    },
    {
      // Legacy projects that declare the MSBuild 2003 namespace.
      "namespace": "http://schemas.microsoft.com/developer/msbuild/2003",
      "url": "./schemas/Microsoft.Build.Namespaced.xsd"
    }
  ]
}
