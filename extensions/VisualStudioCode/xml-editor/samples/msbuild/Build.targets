<Project>

  <Target Name="PrintSampleBanner" BeforeTargets="Build" Condition="'$(SampleBanner)' != ''">
    <Message Text="$(SampleBanner)" Importance="high" />
    <ItemGroup>
      <_SampleFiles Include="@(SampleAsset)" />
    </ItemGroup>
    <Copy SourceFiles="@(_SampleFiles)" DestinationFolder="$(OutDir)assets" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="_CopiedSampleFiles" />
    </Copy>
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath" RemoveProperties="TargetFramework" />
  </Target>

</Project>
