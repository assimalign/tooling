<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
        <TargetFramework>$(TargetFrameworkForAnalyzers)</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<RootNamespace>Assimalign.CodeAnalysis.Internal</RootNamespace>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="All" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="All" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="DiagnosticAnalyzers\CodeStlye\" />
	</ItemGroup>
	<ItemGroup>
		<!-- C#-only analyzer -->
		<None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" />
		<!-- If language-agnostic instead, use: analyzers/dotnet -->
		<!-- If VB, use: analyzers/dotnet/vb -->
	</ItemGroup>
</Project>