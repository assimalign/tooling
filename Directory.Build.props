<Project>
	<PropertyGroup>
		<Authors>Chase Crawford</Authors>
		<RepositoryType>git</RepositoryType>
		<!-- GitHub Packages links a package to a repository through this URL. Without it the
		     publish is rejected for the workflow's GITHUB_TOKEN. -->
		<RepositoryUrl>https://github.com/assimalign/tooling</RepositoryUrl>
		<Company>Assimalign</Company>
		<Copyright>© Assimalign $([System.DateTime]::Now.ToString(`yyyy`))</Copyright>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<!-- Fixed Version Info -->
	<PropertyGroup>
		<MajorVersion>1</MajorVersion>
		<MinorVersion>0</MinorVersion>
		<PatchVersion>1</PatchVersion>
	</PropertyGroup>
	<!-- Target Frameworks -->
	<PropertyGroup>
		<TargetFrameworksDefault>net10.0</TargetFrameworksDefault>
		<TargetFrameworkForAnalyzers>netstandard2.0</TargetFrameworkForAnalyzers>
	</PropertyGroup>
	<!-- Cohesion Build Properties -->
	<PropertyGroup>
		<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
	</PropertyGroup>
	<!-- Output Layout: every package lands in one place so the release pipeline has a single
	     directory to collect from, and a local 'dotnet pack' behaves the same way CI does. -->
	<PropertyGroup>
		<RepositoryDirectory>$(MSBuildThisFileDirectory)</RepositoryDirectory>
		<OutputDirectory>$(RepositoryDirectory)_out</OutputDirectory>
		<PackageOutputPath>$(OutputDirectory)/packages</PackageOutputPath>
	</PropertyGroup>
</Project>